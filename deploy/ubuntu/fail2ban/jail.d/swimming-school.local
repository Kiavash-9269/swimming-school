# Swimming-school production jails (installed by harden-production.sh)
# Iranian mobile carriers put many users behind one CGNAT IP, so web jails
# use high thresholds and short bans to avoid locking out real visitors.

[DEFAULT]
bantime  = 1h
findtime = 10m
maxretry = 5
backend  = systemd

[sshd]
enabled  = true
port     = ssh
maxretry = 4
bantime  = 24h

[nginx-limit-req]
enabled  = true
filter   = nginx-limit-req
port     = http,https
logpath  = /var/log/nginx/*error*.log
maxretry = 60
findtime = 2m
bantime  = 30m

[nginx-botsearch]
enabled  = true
filter   = nginx-botsearch
port     = http,https
logpath  = /var/log/nginx/*error*.log
maxretry = 5
findtime = 5m
bantime  = 6h
