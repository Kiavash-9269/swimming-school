NODE_ENV=development
PORT=4000
MONGODB_URI=mongodb://127.0.0.1:27017/swimming-school
JWT_ACCESS_SECRET=replace-with-long-random-access-secret
JWT_REFRESH_SECRET=replace-with-long-random-refresh-secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
JWT_REGISTRATION_EXPIRES_IN=15m
JWT_PASSWORD_RESET_EXPIRES_IN=15m
FRONTEND_URL=http://127.0.0.1:5173
COOKIE_SECURE=false
LOG_LEVEL=info

# OTP
OTP_TTL_SECONDS=120
OTP_RESEND_COOLDOWN_SECONDS=60
OTP_MAX_ATTEMPTS=5
OTP_CODE_LENGTH=5
OTP_RATE_LIMIT_PER_PHONE=5
OTP_RATE_LIMIT_WINDOW_SEC=600

# SMS provider: development | niksms | sms-webservice | kavenegar
# Production must use niksms, sms-webservice, or kavenegar (never development).
SMS_PROVIDER=niksms
SMS_TIMEOUT_MS=20000

# Niksms SOAP Web Service (Username/Password — NOT an API key)
# WSDL: http://94.182.154.28:1370/NiksmsWebservice.svc?wsdl
# Auth: AuthenticationModel { Username, Password } on every method
NIKSMS_USERNAME=
NIKSMS_PASSWORD=
# Exact line from GetSenderNumbers (with or without 98). Service line preferred.
NIKSMS_SENDER=985000403011
# SOAP endpoint (no ?wsdl) — used for GetCredit / delivery / SOAP fallback
NIKSMS_ENDPOINT=http://94.182.154.28:1370/NiksmsWebservice.svc
# Primary send path (API v2 SendOne) — this one actually charges credit
NIKSMS_REST_URL=https://niksms.com/api/v2/send/one
# Local only: show OTP in API while debugging (never enable in production)
SMS_EXPOSE_DEV_OTP=false
# Local/dev: higher limit so probing does not block real OTP tests
OTP_RATE_LIMIT_PER_PHONE=30
OTP_RESEND_COOLDOWN_SECONDS=30

# sms-webservice.com / PayamResan REST (separate product; ApiKey auth)
SMS_WEBSERVICE_API_KEY=
SMS_WEBSERVICE_SENDER=
SMS_WEBSERVICE_TEMPLATE_KEY=
# Prefer HTTP; HTTPS may time out on some networks
SMS_WEBSERVICE_BASE_URL=http://api.sms-webservice.com/api/V3

# Kavenegar (alternative)
KAVENEGAR_API_KEY=
KAVENEGAR_SENDER=
KAVENEGAR_TEMPLATE=

# Course domain
APP_TIMEZONE=Asia/Tehran
RESERVATION_HOLD_SECONDS=900
WAITLIST_OFFER_SECONDS=900
# mock = test/dev and pre-launch production (no Zarinpal yet). Switch to zarinpal when live.
PAYMENT_PROVIDER=mock
PAYMENT_CALLBACK_URL=http://127.0.0.1:4000/api/payments/callback
# Required in production (mock or zarinpal). Header: x-payment-callback-secret
PAYMENT_CALLBACK_SECRET=change-me-payment-callback-secret-min-32-chars
PAYMENT_TIMEOUT_MS=15000
# Only when PAYMENT_PROVIDER=zarinpal:
ZARINPAL_MERCHANT_ID=
ZARINPAL_SANDBOX=true
# Future provider credentials (placeholders only — use when adapter exists):
# PAYMENT_PROVIDER=<provider-slug>
# PROVIDER_X_MERCHANT_ID=
# PROVIDER_X_TERMINAL_ID=
# PROVIDER_X_API_KEY=

# Notifications / scheduler (Phase 5)
# Local: SCHEDULER_ENABLED=true. Production VPS: false + deploy/ubuntu/swimming-jobs.timer
SCHEDULER_ENABLED=true
SCHEDULER_INTERVAL_MS=120000
MONGO_MAX_POOL_SIZE=5
JOB_BATCH_SIZE=20
JOB_REMINDER_EVERY_N_TICKS=100
JOB_REMINDERS_ENABLED=false
NOTIFICATION_MAX_ATTEMPTS=3
NOTIFICATION_LEASE_SECONDS=60
NOTIFICATION_DEFAULT_LOCALE=fa
CLASS_REMINDER_HOURS=24
SESSION_REMINDER_HOURS=1
EMAIL_PROVIDER=mock

# Admin Excel exports (Phase 6)
EXPORT_MAX_ROWS=5000

# Document storage (Phase 7) — local filesystem, NOT under frontend/public
# Production: mount a persistent volume at DOCUMENT_STORAGE_ROOT (or default backend/.data/documents).
DOCUMENT_STORAGE_PROVIDER=local
# Optional absolute path; default: backend/.data/documents
# DOCUMENT_STORAGE_ROOT=
DOCUMENT_MAX_BYTES=5242880

APP_VERSION=1.0.0

# Reserved / unused by member auth (do not confuse with JWT_ACCESS_EXPIRES_IN / JWT_REFRESH_EXPIRES_IN)
# JWT_MEMBER_EXPIRATION=7d

# Future Super Admin Panel (NOT used by member authentication â€” leave empty until that module exists)
# SUPER_OWNER_USERNAME=
# SUPER_OWNER_PASSWORD=
# SUPER_JWT_SECRET=
# SUPER_JWT_REFRESH_SECRET=
# SUPER_JWT_EXPIRATION=
# SUPER_JWT_REFRESH_EXPIRATION=
# SUPER_JWT_REFRESH_REMEMBER=
