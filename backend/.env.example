NODE_ENV=development
PORT=4000
MONGODB_URI=mongodb://127.0.0.1:27017/swimming-school
JWT_ACCESS_SECRET=replace-with-long-random-access-secret
JWT_REFRESH_SECRET=replace-with-long-random-refresh-secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
JWT_REGISTRATION_EXPIRES_IN=15m
JWT_PASSWORD_RESET_EXPIRES_IN=15m
FRONTEND_URL=http://127.0.0.1:5173
COOKIE_SECURE=false
LOG_LEVEL=info

# OTP
OTP_TTL_SECONDS=120
OTP_RESEND_COOLDOWN_SECONDS=60
OTP_MAX_ATTEMPTS=5
OTP_CODE_LENGTH=5
OTP_RATE_LIMIT_PER_PHONE=5
OTP_RATE_LIMIT_WINDOW_SEC=600

# SMS provider: development | sms-webservice | kavenegar
# Production must use sms-webservice or kavenegar (never development).
SMS_PROVIDER=development
SMS_TIMEOUT_MS=20000

# sms-webservice.com (primary production provider)
SMS_WEBSERVICE_API_KEY=
SMS_WEBSERVICE_SENDER=
SMS_WEBSERVICE_TEMPLATE_KEY=
# Prefer HTTP; HTTPS may time out on some networks
SMS_WEBSERVICE_BASE_URL=http://api.sms-webservice.com/api/V3

# Kavenegar (alternative)
KAVENEGAR_API_KEY=
KAVENEGAR_SENDER=
KAVENEGAR_TEMPLATE=

# Course domain
APP_TIMEZONE=Asia/Tehran
RESERVATION_HOLD_SECONDS=900
WAITLIST_OFFER_SECONDS=900
PAYMENT_PROVIDER=mock
# Production MUST set PAYMENT_PROVIDER=zarinpal (mock is refused at boot).
PAYMENT_CALLBACK_URL=
PAYMENT_CALLBACK_SECRET=
PAYMENT_TIMEOUT_MS=15000
# Required only when PAYMENT_PROVIDER=zarinpal — never commit real secrets
ZARINPAL_MERCHANT_ID=
ZARINPAL_SANDBOX=true

# Notifications / in-process scheduler (Phase 5)
# In production defaults to enabled when unset; set SCHEDULER_ENABLED=false to disable.
SCHEDULER_ENABLED=false
SCHEDULER_INTERVAL_MS=15000
JOB_BATCH_SIZE=50
NOTIFICATION_MAX_ATTEMPTS=3
NOTIFICATION_LEASE_SECONDS=60
NOTIFICATION_DEFAULT_LOCALE=fa
CLASS_REMINDER_HOURS=24
SESSION_REMINDER_HOURS=1
EMAIL_PROVIDER=mock

# Admin Excel exports (Phase 6)
EXPORT_MAX_ROWS=5000

# Document storage (Phase 7) — local filesystem, NOT under frontend/public
# Production: mount a persistent volume at DOCUMENT_STORAGE_ROOT (or default backend/.data/documents).
DOCUMENT_STORAGE_PROVIDER=local
# Optional absolute path; default: backend/.data/documents
# DOCUMENT_STORAGE_ROOT=
DOCUMENT_MAX_BYTES=5242880

APP_VERSION=1.0.0

# Reserved / unused by member auth (do not confuse with JWT_ACCESS_EXPIRES_IN / JWT_REFRESH_EXPIRES_IN)
# JWT_MEMBER_EXPIRATION=7d

# Future Super Admin Panel (NOT used by member authentication â€” leave empty until that module exists)
# SUPER_OWNER_USERNAME=
# SUPER_OWNER_PASSWORD=
# SUPER_JWT_SECRET=
# SUPER_JWT_REFRESH_SECRET=
# SUPER_JWT_EXPIRATION=
# SUPER_JWT_REFRESH_EXPIRATION=
# SUPER_JWT_REFRESH_REMEMBER=
